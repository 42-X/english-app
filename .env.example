# Optional — enables account sync. Without these the app runs fully local.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key — safe to ship in the client; RLS protects the data.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Only used by `supabase db push` from your machine. Never prefixed with VITE_.
SUPABASE_DB_PASSWORD=
